theorem checkPow2A_succ (lo d : Nat)
    (h1 : checkPow2A lo d = true) (h2 : checkPow2A (lo + 2 ^ d) d = true) :
    checkPow2A lo (d + 1) = true := by
  simp only [checkPow2A, h1, h2, Bool.and_self]

theorem checkPow2A_sound (lo d : Nat) (h : checkPow2A lo d = true) :
    ∀ k, lo ≤ k → k < lo + 2 ^ d → k < 42875 → checkRowA k = true := by
  induction d generalizing lo with
  | zero =>
    intro k hlo hhi hlt
    have hkeq : k = lo := by omega
    subst hkeq
    simp only [checkPow2A] at h
    have hble : Nat.ble 42875 k = false := by
      cases hb : Nat.ble 42875 k with
      | false => rfl
      | true => have := Nat.ble_eq.mp hb; omega
    rw [hble] at h
    exact h
  | succ d ih =>
    simp only [checkPow2A, Bool.and_eq_true] at h
    intro k hlo hhi hlt
    by_cases hmid : k < lo + 2 ^ d
    · exact ih lo h.1 k hlo hmid hlt
    · have h2 : 2 ^ (d + 1) = 2 ^ d + 2 ^ d := by rw [Nat.pow_succ, Nat.mul_two]
      exact ih (lo + 2 ^ d) h.2 k (by omega) (by omega) hlt

