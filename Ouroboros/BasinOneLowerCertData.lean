/-- Unpack 16-bit slot `j < 1024` from a 16384-bit packed `Nat` chunk. -/
def unpack1024 (chunk j : Nat) : Nat :=
  (((chunk / pow4096_4 (j / 256)) / pow256_16 ((j / 16) % 16)) / (2 ^ (16 * (j % 16)))) % 65536

/-- Certified integer weight `w_A(k) ∈ [0, 65535]` for residue `15*k + 1 (mod 643,125)`. -/
def getWA (k : Nat) : Nat := unpack1024 (getChunkA (k / 1024)) (k % 1024)

/-- Certified integer weight `w_B(k) ∈ [0, 65535]` for residue `15*k (mod 128,625)`. -/
