def checkRowA (k : Nat) : Bool := Nat.ble (getWA k * 1048576) (sumA k)
def checkRowC (k : Nat) : Bool := Nat.ble (getWC (k % 6125) * 1048576) (sumC k)
def checkRowB (k : Nat) : Bool :=
  let lhs := getWB (k % 8575)
  match Nat.beq lhs 0 with
  | true => true
  | false => Nat.ble (lhs * 1048576) (sumB k)

def checkPow2A (lo : Nat) : Nat → Bool
  | 0 => match Nat.ble 42875 lo with | true => true | false => checkRowA lo
  | d + 1 => checkPow2A lo d && checkPow2A (lo + 2 ^ d) d

def checkPow2C (lo : Nat) : Nat → Bool
  | 0 => match Nat.ble 42875 lo with | true => true | false => checkRowC lo
  | d + 1 => checkPow2C lo d && checkPow2C (lo + 2 ^ d) d

def checkPow2B (lo : Nat) : Nat → Bool
