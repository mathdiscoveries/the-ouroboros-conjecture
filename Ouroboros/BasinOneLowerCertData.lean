/-- Repeated-squaring `x ^ 800` (512 + 256 + 32 = 800) with zero exponentiation warnings. -/
def pow800 (x : Nat) : Nat :=
  let x2 := x * x
  let x4 := x2 * x2
  let x8 := x4 * x4
  let x16 := x8 * x8
  let x32 := x16 * x16
  let x64 := x32 * x32
  let x128 := x64 * x64
  let x256 := x128 * x128
  let x512 := x256 * x256
  x512 * x256 * x32

/-- Repeated-squaring `x ^ 399` (256 + 128 + 8 + 4 + 2 + 1 = 399). -/
def pow399 (x : Nat) : Nat :=
  let x2 := x * x
  let x4 := x2 * x2
  let x8 := x4 * x4
  let x16 := x8 * x8
  let x32 := x16 * x16
  let x64 := x32 * x32
  let x128 := x64 * x64
  let x256 := x128 * x128
  x256 * x128 * x8 * x4 * x2 * x

/-- Pure-kernel `800`-th power proof: `(759908250 / 2^30)^800 * 2^399 ≤ 1`. -/
theorem check_halfSC : Nat.ble (pow800 759908250 * pow399 2) (pow800 1073741824) = true := rfl

/-- Pure-kernel `800`-th power proof: `(2396134319 / 2^30)^800 ≤ 5^399`. -/
theorem check_d5SC : Nat.ble (pow800 2396134319) (pow800 1073741824 * pow399 5) = true := rfl

/-- Pure-kernel `800`-th power proof: `(2833952177 / 2^30)^800 ≤ 7^399`. -/
theorem check_d7SC : Nat.ble (pow800 2833952177) (pow800 1073741824 * pow399 7) = true := rfl

/-- Recurrence for `floor(2^30 * (d / 2^v)^(399/800))`. -/
def termSC (t0 : Nat) : Nat → Nat
  | 0 => t0
  | v + 1 => (termSC t0 v * 759908250) / 1073741824

/-- Scaled integer coefficient `floor(2^20 * (d / 2^v)^(399/800))`. -/
def coeffOf (t0 v : Nat) : Nat := termSC t0 v / 1024

