/-- Exact unrolled `Vmax = 25` move sum at class-`A` residue `o = 15 * k + 1`. -/
def sumA (k : Nat) : Nat :=
  let c0 := (2 * k) % 42875
  let c1 := (16 * c0 + 2) % 42875
  let c2 := (16 * c1 + 2) % 42875
  let c3 := (16 * c2 + 2) % 42875
  let c4 := (16 * c3 + 2) % 42875
  let c5 := (16 * c4 + 2) % 42875
  let c6 := (16 * c5 + 2) % 42875
  let s1 := 742097 * getWA c0 + 186168 * getWA c1 + 46703 * getWA c2 +
            11716 * getWA c3 + 2939 * getWA c4 + 737 * getWA c5 + 184 * getWA c6
  let o := 15 * k + 1
  let r5 := k % 5
  let s5 :=
    match Nat.beq r5 0 with
    | true => 2325 * getWB (((405451 * o) % 643125 - 1) / 75)
    | false => match Nat.beq r5 1 with
      | true => 9268 * getWB (((65536 * o) % 643125 - 1) / 75)
      | false => match Nat.beq r5 2 with
        | true => 36944 * getWB (((4096 * o) % 643125 - 1) / 75)
        | false => match Nat.beq r5 3 with
          | true => 147265 * getWB (((256 * o) % 643125 - 1) / 75)
          | false =>
            587024 * getWB (((16 * o) % 643125 - 1) / 75) +
            583 * getWB (((55966 * o) % 643125 - 1) / 75)
  s1 + s5

