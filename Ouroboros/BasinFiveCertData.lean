/-- Certified integer lower bound for `10^6 * (digitVal di / 2^(vi+1))^0.65`. -/
def getC (di vi : Nat) : Nat :=
  match di with
  | 0 => cTree0.get 2 vi
  | 1 => cTree1.get 2 vi
  | 2 => cTree2.get 2 vi
  | 3 => cTree3.get 2 vi
  | _ => cTree4.get 2 vi
/-- Pure-kernel proof that every stored weight is `≤ 10^6`. -/
theorem wTree_allLe : wTree.allLe 1000000 = true := rfl
theorem getW_le_scale (i : Nat) : getW i ≤ 1000000 :=
  QuadTree.get_le_of_allLe wTree wTree_allLe 8 i
/-- Pure-kernel value at root type `(14175, 3)`: `getW 3 = 98959`. -/
theorem getW_root : getW 3 = 98959 := rfl
/-- Pure-kernel 20th-power check: `C(di, v)^20 * 2^(13*v) ≤ 10^120 * d^13`. -/
def checkCoeffOne (di vi : Nat) : Bool :=
  let d := match di with | 0 => 1 | 1 => 3 | 2 => 5 | 3 => 7 | _ => 9
  let c := getC di vi
  let v := vi + 1
  Nat.ble (c ^ 20 * 2 ^ (13 * v)) (1000000 ^ 20 * d ^ 13)
def checkCoeffDigit (di : Nat) : Nat → Bool
  | 0 => true
  | n + 1 => checkCoeffOne di n && checkCoeffDigit di n
def checkCoeffAll : Bool :=
  checkCoeffDigit 0 16 && checkCoeffDigit 1 16 && checkCoeffDigit 2 16 &&
  checkCoeffDigit 3 16 && checkCoeffDigit 4 16
/-- Pure-kernel verification of all 80 real-exponent coefficient lower bounds. -/
theorem checkCoeffAll_true : checkCoeffAll = true := rfl
/-- One halving-level contribution `v = vi + 1` at `x1 = (2^v * R) % 14175`. -/
def stepSum (vi x1 : Nat) : Nat :=
  let r5 := x1 % 5
  match Nat.beq r5 0 with
  | true =>
    let xm1 := match Nat.beq x1 0 with | true => 14174 | false => x1 - 1
    let s3 := match Nat.beq (x1 % 3) 1 with
      | true => cTree1.get 2 vi * getW (14175 + xm1 / 3)
      | false => 0
    let s7 := match Nat.beq (x1 % 7) 1 with
      | true => cTree3.get 2 vi * getW (21735 + xm1 / 7)
      | false => 0
    s3 + s7
  | false =>
    match Nat.beq r5 1 with
    | true =>
      match Nat.beq (x1 % 25) 1 with
      | true => cTree2.get 2 vi * getW (18900 + (x1 - 1) / 5)
      | false => 0
    | false =>
      match Nat.beq r5 2 with
      | true =>
        let xm1 := x1 - 1
        let s1 := cTree0.get 2 vi * getW xm1
        let s9 := match Nat.beq (x1 % 9) 1 with
          | true => cTree4.get 2 vi * getW (23760 + xm1 / 9)
          | false => 0
        s1 + s9
      | false => 0
/-- Accumulate `stepSum vi ((2^(vi+1) * R) % 14175)` for `vi = 0 .. 15`. -/
def sumMovesAux : Nat → Nat → Nat → Nat → Nat
  | 0, _, _, acc => acc
  | rem + 1, vi, x, acc =>
    let x1 := (2 * x) % 14175
    sumMovesAux rem (vi + 1) x1 (acc + stepSum vi x1)
/-- Check all 5 type super-eigenvector inequalities at residue `R < 14175`. -/
def checkR (R : Nat) : Bool :=
  let s := sumMovesAux 16 0 R 0
  Nat.ble (getW R * 1000000) s &&
  Nat.ble (getW (14175 + R % 4725) * 1000000) s &&
  Nat.ble (getW (18900 + R % 2835) * 1000000) s &&
  Nat.ble (getW (21735 + R % 2025) * 1000000) s &&
  Nat.ble (getW (23760 + R % 1575) * 1000000) s
/-- Binary-splitting pure-kernel range checker over `[lo, lo + 2^d) ∩ [0, 14175)`. -/
def checkPow2 (lo : Nat) : Nat → Bool
  | 0 => match Nat.ble 14175 lo with | true => true | false => checkR lo
  | d + 1 => checkPow2 lo d && checkPow2 (lo + 2 ^ d) d
theorem checkPow2_succ (lo d : Nat)
    (h1 : checkPow2 lo d = true) (h2 : checkPow2 (lo + 2 ^ d) d = true) :
    checkPow2 lo (d + 1) = true := by
  simp only [checkPow2, h1, h2, Bool.and_self]
theorem checkPow2_sound (lo d : Nat) (h : checkPow2 lo d = true) :
    ∀ R, lo ≤ R → R < lo + 2 ^ d → R < 14175 → checkR R = true := by
  induction d generalizing lo with
  | zero =>
    intro R hlo hhi hlt
    have hReq : R = lo := by omega
    subst hReq
    simp only [checkPow2] at h
    have hble : Nat.ble 14175 R = false := by
      cases hb : Nat.ble 14175 R with
      | false => rfl
      | true =>
        have := Nat.ble_eq.mp hb
        omega
    rw [hble] at h
    exact h
  | succ d ih =>
    simp only [checkPow2, Bool.and_eq_true] at h
    intro R hlo hhi hlt
    by_cases hmid : R < lo + 2 ^ d
    · exact ih lo h.1 R hlo hmid hlt
    · have h2 : 2 ^ (d + 1) = 2 ^ d + 2 ^ d := by
        rw [Nat.pow_succ, Nat.mul_two]
      exact ih (lo + 2 ^ d) h.2 R (by omega) (by omega) hlt
