/-- Check all 3 classes `(B, A, C)` at quotient `q < 42875`, plus positivity `1 ≤ w`. -/
def checkQ (q : Nat) : Bool :=
  let r0 := 15 * q
  let wA := getWA q
  let wB := getWB (q % 8575)
  let wC := getWC (q % 6125)
  Nat.ble 1 wA && Nat.ble 1 wB && Nat.ble 1 wC &&
  Nat.ble (tailAVal + sumD1A (r0 + 1) + sumD5A (r0 + 1)) (1000000 * wA) &&
  Nat.ble (tailAVal + sumD1C (r0 + 2) + sumD5C (r0 + 2)) (1000000 * wC) &&
  (match Nat.beq (r0 % 7) 1 || Nat.beq (r0 % 7) 2 || Nat.beq (r0 % 7) 4 with
   | true => Nat.ble (tailBVal + sumD7B r0) (1000000 * wB)
   | false => true)

def checkPow2 (lo : Nat) : Nat → Bool
  | 0 => match Nat.ble 42875 lo with | true => true | false => checkQ lo
  | d + 1 => checkPow2 lo d && checkPow2 (lo + 2 ^ d) d

theorem checkPow2_succ (lo d : Nat)
    (h1 : checkPow2 lo d = true) (h2 : checkPow2 (lo + 2 ^ d) d = true) :
    checkPow2 lo (d + 1) = true := by
  simp only [checkPow2, h1, h2, Bool.and_self]

theorem checkPow2_sound (lo d : Nat) (h : checkPow2 lo d = true) :
    ∀ q, lo ≤ q → q < lo + 2 ^ d → q < 42875 → checkQ q = true := by
  induction d generalizing lo with
  | zero =>
    intro q hlo hhi hlt
    have hq : q = lo := by omega
    subst hq
    simp only [checkPow2] at h
    have hble : Nat.ble 42875 q = false := by
      cases hb : Nat.ble 42875 q with
      | false => rfl
      | true =>
        have := Nat.ble_eq.mp hb
        omega
    rw [hble] at h
    exact h
  | succ d ih =>
    simp only [checkPow2, Bool.and_eq_true] at h
    intro q hlo hhi hlt
    by_cases hmid : q < lo + 2 ^ d
    · exact ih lo h.1 q hlo hmid hlt
    · have h2 : 2 ^ (d + 1) = 2 ^ d + 2 ^ d := by
        rw [Nat.pow_succ, Nat.mul_two]
      exact ih (lo + 2 ^ d) h.2 q (by omega) (by omega) hlt

