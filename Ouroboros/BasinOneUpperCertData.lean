namespace Ouroboros.BasinOneUpperCert

/-- 4-way base-4 LSB-first radix tree for O(depth) pure-kernel lookups. -/
inductive QuadTree where
  | Z : QuadTree
  | L : Nat → QuadTree
  | Q : QuadTree → QuadTree → QuadTree → QuadTree → QuadTree

open QuadTree

/-- Pure-kernel lookup at index `i` using only `Nat.beq`. -/
def QuadTree.get : Nat → QuadTree → Nat → Nat
  | _, Z, _ => 0
  | _, L v, _ => v
  | 0, Q _ _ _ _, _ => 0
  | d + 1, Q t0 t1 t2 t3, i =>
    let r := i % 4
    let q := i / 4
    match Nat.beq r 0 with
    | true => t0.get d q
    | false =>
      match Nat.beq r 1 with
      | true => t1.get d q
      | false =>
        match Nat.beq r 2 with
        | true => t2.get d q
        | false => t3.get d q

def QuadTree.allLe (bound : Nat) : QuadTree → Bool
  | Z => true
  | L v => Nat.ble v bound
  | Q t0 t1 t2 t3 =>
    t0.allLe bound && t1.allLe bound && t2.allLe bound && t3.allLe bound

theorem QuadTree.get_le_of_allLe {bound : Nat} (t : QuadTree)
    (h : t.allLe bound = true) : ∀ d i, t.get d i ≤ bound := by
  induction t with
  | Z => intro d i; simp [QuadTree.get]
  | L v =>
    intro d i
    simp only [QuadTree.allLe, Nat.ble_eq] at h
    simp [QuadTree.get, h]
  | Q t0 t1 t2 t3 ih0 ih1 ih2 ih3 =>
    simp only [QuadTree.allLe, Bool.and_eq_true] at h
    intro d i
    cases d with
    | zero => simp [QuadTree.get]
    | succ d =>
      simp only [QuadTree.get]
      split
      · exact ih0 h.1.1.1 d (i / 4)
      · split
        · exact ih1 h.1.1.2 d (i / 4)
        · split
          · exact ih2 h.1.2 d (i / 4)
          · exact ih3 h.2 d (i / 4)

